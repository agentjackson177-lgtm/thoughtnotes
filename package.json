{
  "name": "mindmap-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd server && npm run dev",
    "dev:worker": "XDG_CONFIG_HOME=.wrangler/config XDG_CACHE_HOME=.wrangler/cache wrangler dev",
    "deploy:worker": "XDG_CONFIG_HOME=.wrangler/config XDG_CACHE_HOME=.wrangler/cache wrangler deploy",
    "d1:local:init": "XDG_CONFIG_HOME=.wrangler/config XDG_CACHE_HOME=.wrangler/cache wrangler d1 execute mindmap-db --local --file worker/schema.sql",
    "d1:remote:init": "XDG_CONFIG_HOME=.wrangler/config XDG_CACHE_HOME=.wrangler/cache wrangler d1 execute mindmap-db --remote --file worker/schema.sql",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "cd server && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wrangler": "^4.61.0"
  }
}
